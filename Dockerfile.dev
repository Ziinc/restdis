FROM hexpm/elixir:1.20.3-erlang-28.1.1-debian-trixie-20260803-slim

RUN apt-get update -y && \
    apt-get install -y build-essential git inotify-tools curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Debian trixie's own rustc (1.85) predates rustler 0.38's MSRV (1.91), so
# the toolchain comes from rustup instead of apt.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

RUN mix local.hex --force && \
    mix local.rebar --force

WORKDIR /app
